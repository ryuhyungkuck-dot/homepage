# Supabase 프로젝트 > Project Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 관리자 로그인 이메일 (Supabase Auth에 만든 계정과 같아야 함)
ADMIN_EMAIL=smart@paxc.co.kr

# 홈페이지 주소 (사이트맵·대표 주소에 사용)
NEXT_PUBLIC_SITE_URL=https://paxc.co.kr

# 네이버 카페 표시 이름
NEXT_PUBLIC_CAFE_NAME=식품제조

# 검색엔진 소유 확인 코드 (Google Search Console / 네이버 서치어드바이저)
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_NAVER_VERIFICATION=

# 지원사업 자동 등록 API (/api/support) — 서버 전용, 절대 NEXT_PUBLIC_ 붙이지 말 것
# Supabase > Project Settings > API 의 service_role(또는 Secret) 키
SUPABASE_SERVICE_ROLE_KEY=
# 파이프라인과 홈페이지가 함께 쓰는 비밀 토큰 (24자 이상 아무 문자열)
SUPPORT_API_TOKEN=

# 기업마당 자동 수집 (매일 오전 7시, /api/cron/bizinfo)
# 기업마당 > 활용정보 > 정책정보 개방 > API 사용 신청 에서 발급
BIZINFO_API_KEY=
# Vercel Cron 보호용 비밀값 (24자 이상 아무 문자열). Vercel이 자동으로 Authorization 헤더에 넣어 호출합니다.
CRON_SECRET=
