# Supabase 프로젝트 > Project Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 관리자 로그인 이메일 (Supabase Auth에 만든 계정과 같아야 함)
ADMIN_EMAIL=smart@paxc.co.kr

# 홈페이지 주소 (사이트맵·대표 주소에 사용)
NEXT_PUBLIC_SITE_URL=https://paxc.co.kr

# 네이버 카페 표시 이름
NEXT_PUBLIC_CAFE_NAME=식품제조

# 검색엔진 소유 확인 코드 (Google Search Console / 네이버 서치어드바이저)
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_NAVER_VERIFICATION=
